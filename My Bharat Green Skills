import time

class GreenSkillsPortal:
    def __init__(self):
        self.regional_db = {
            "balaghat": {
                "district_name": "Balaghat, MP",
                "partner_industries": ["MOIL (Manganese Ore India Ltd)", "HCL (Hindustan Copper Ltd)"],
                "available_tasks": [{"task_id": 101, "name": "बांस के अवशेषों से इको-फर्नीचर निर्माण", "base_credits": 50}]
            }
        }
        self.user_wallet = {"name": "रामलाल बैगा", "location": "Balaghat", "earned_credits": 0}

    def simulate_submission(self, task_id, latitude, longitude):
        print(f"\n🚀 [MY BHARAT] नया सबमिशन प्राप्त हुआ | Lat {latitude}, Long {longitude}")
        time.sleep(1)
        
        # Module 1: AI Verification
        print("🔍 [AI VERIFICATION] अपलोड की गई फोटो की जांच की जा रही है...")
        print("✅ AI वेरिफिकेशन सफल! कार्य प्रामाणिक पाया गया।")
        
        # Module 2: GIS Tracking
        print("🛰️ [GIS & SATELLITE] लोकेशन ट्रैक की जा रही है...")
        if 21.5 <= latitude <= 22.5 and 80.0 <= longitude <= 81.0:
            print("🎯 GIS पुष्टि: लोकेशन MOIL/HCL खदान के प्रभावित ग्रीन-बेल्ट क्षेत्र में है।")
            self.user_wallet["earned_credits"] += 50
            print(f"🎉 बधाई हो {self.user_wallet['name']}! आपके वॉलेट में 50 Green Credits जोड़ दिए गए हैं।")
            print(f"🏢 [CSR LINKAGE] आप MOIL/HCL के आगामी अप्रेंटिसशिप बैच में 1st Priority के लिए क्वालिफाइड हैं!")
            return True
        else:
            print("❌ GIS अलर्ट: लोकेशन माइनिंग क्षेत्र से बाहर है।")
            return False

if __name__ == "__main__":
